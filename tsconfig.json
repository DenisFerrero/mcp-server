{
	"compilerOptions": {
		"allowJs": true,
		"strict": false,
		"checkJs": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["es2024"],
		"types": ["node"],
		"module": "node16",
		"moduleResolution": "node16",
		"target": "es2023",

		"declaration": false,
		"outDir": "dist",
		"rootDir": "src",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"rewriteRelativeImportExtensions": true,
		"isolatedModules": true,
		"resolveJsonModule": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", ".eslintrc.js", "prettier.config.js", "dist"],
}
